+    '[{"todos": {"0": {"text": "buy milk", "completed": false}, "1": {"text": "walk the dog", "completed": true}}}, {}]\n',
+  'state-exams/expected/one-open-todo.json':
+    '[{"todos": {"0": {"text": "buy milk", "completed": false}}}, {}]\n',
