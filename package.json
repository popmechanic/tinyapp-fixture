{
  "name": "tinyapp-fixture",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "scripts": {
    "lint:state": "bun packages/tinyapp-lint/src/cli.ts",
    "lint:ui": "node node_modules/eslint/bin/eslint.js client/src",
    "history": "bun packages/tinyapp-history/src/cli.ts",
    "typecheck": "bun run --cwd client tsc --noEmit && bun run --cwd server tsc --noEmit && bunx tsc -p packages/tinyapp-lint --noEmit && bunx tsc -p packages/tinyapp-history --noEmit && bunx tsc -p packages/tinyapp-exam --noEmit",
    "test": "bun run typecheck && bun test",
    "build:facets": "bun run --cwd server build:facets",
    "postinstall": "bun run build:facets"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.0",
    "@types/bun": "^1.3.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "tailwindcss": "^4.3.3",
    "tinyapp-exam": "workspace:*",
    "typescript": "^6.0.3"
  }
}
